# AGROVISION - Environment Variables Configuration Template
# Smart India Hackathon 2025 - SIH25044

# Django Settings
DJANGO_SECRET_KEY=agrovision-in-production-secret-key-change-this-sih25044
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL)
# When set, AGROVISION automatically connects to PostgreSQL.
# If unset, AGROVISION falls back to SQLite for local development.
POSTGRES_DB=agrovision_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Alternatively provide a direct database URL:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/agrovision_db

# External API Integrations (Optional in Phase 1, activated in Phase 4-8)
# Open-Meteo Weather API requires no key (free tier)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Google Gemini API for AI Assistant (Phase 8)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Earth Engine (Phase 5)
GEE_SERVICE_ACCOUNT=your_gee_service_account@project.iam.gserviceaccount.com
GEE_PRIVATE_KEY_FILE=path/to/gee-private-key.json

# Government Data Platform (data.gov.in / AGMARKNET API) (Phase 2 & 4)
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here
